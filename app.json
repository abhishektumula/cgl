{
  "expo": {
    "name": "Prep Planner",
    "slug": "prep-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prepplanner.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DE6A9C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.prepplanner.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E68AAE"
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "FocusWidget",
              "displayName": "Focus timer",
              "description": "Live countdown and today's study time",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 140,
                "minHeight": 140
              }
            },
            {
              "name": "TasksWidget",
              "displayName": "Up next",
              "description": "Your next tasks at a glance",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              },
              "android": {
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "minWidth": 210,
                "minHeight": 140
              }
            },
            {
              "name": "CalendarWidget",
              "displayName": "Today's plan",
              "description": "Today's date and study sessions",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              },
              "android": {
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "minWidth": 210,
                "minHeight": 140
              }
            }
          ]
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Sage",
            "ios": "./assets/icons/Sage.png",
            "android": {
              "foregroundImage": "./assets/icons/Sage-foreground.png",
              "backgroundImage": "./assets/icons/Sage-background.png",
              "backgroundColor": "#3F7563"
            }
          },
          {
            "name": "Lavender",
            "ios": "./assets/icons/Lavender.png",
            "android": {
              "foregroundImage": "./assets/icons/Lavender-foreground.png",
              "backgroundImage": "./assets/icons/Lavender-background.png",
              "backgroundColor": "#7F69CF"
            }
          },
          {
            "name": "Peach",
            "ios": "./assets/icons/Peach.png",
            "android": {
              "foregroundImage": "./assets/icons/Peach-foreground.png",
              "backgroundImage": "./assets/icons/Peach-background.png",
              "backgroundColor": "#EC8460"
            }
          },
          {
            "name": "Sky",
            "ios": "./assets/icons/Sky.png",
            "android": {
              "foregroundImage": "./assets/icons/Sky-foreground.png",
              "backgroundImage": "./assets/icons/Sky-background.png",
              "backgroundColor": "#4A8FCB"
            }
          },
          {
            "name": "Bloom",
            "ios": "./assets/icons/Bloom.png",
            "android": {
              "foregroundImage": "./assets/icons/Bloom-foreground.png",
              "backgroundImage": "./assets/icons/Bloom-background.png",
              "backgroundColor": "#B58BE8"
            }
          },
          {
            "name": "Heart",
            "ios": "./assets/icons/Heart.png",
            "android": {
              "foregroundImage": "./assets/icons/Heart-foreground.png",
              "backgroundImage": "./assets/icons/Heart-background.png",
              "backgroundColor": "#E0527F"
            }
          },
          {
            "name": "Midnight",
            "ios": "./assets/icons/Midnight.png",
            "android": {
              "foregroundImage": "./assets/icons/Midnight-foreground.png",
              "backgroundImage": "./assets/icons/Midnight-background.png",
              "backgroundColor": "#14162E"
            }
          }
        ]
      ]
    ],
    "scheme": "prepplanner",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "68293307-fa9f-4c77-9376-70727d45343a"
      }
    },
    "owner": "abhishekat9",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/68293307-fa9f-4c77-9376-70727d45343a"
    }
  }
}
